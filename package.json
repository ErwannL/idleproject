{
  "name": "idle-rpg",
  "productName": "Ascendrya",
  "version": "10.19.0",
  "private": true,
  "description": "RPG idle 2D en pixel art pour PC (fenêtre compacte).",
  "author": "ErwannL",
  "type": "module",
  "main": "desktop/main.cjs",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node tools/serve.mjs",
    "build:web": "node tools/build-web.mjs",
    "build:dev": "node tools/build-web.mjs --dev",
    "serve:dev": "node tools/serve-dev.mjs",
    "server": "node server/index.mjs",
    "app": "node tools/launch.mjs",
    "desktop": "electron .",
    "test": "node --test",
    "smoke": "node tools/smoke.mjs",
    "art": "python3 tools/art/build.py",
    "export-assets": "node tools/export-assets.mjs",
    "dist:win": "electron-builder --win --publish never",
    "test:exe": "node tools/desktop-smoke.mjs",
    "test:upgrade": "node tools/upgrade-smoke.mjs",
    "e2e:beginner": "node tools/e2e-beginner.mjs",
    "capture": "node tools/capture.mjs",
    "dist:linux": "electron-builder --linux --x64 --publish never",
    "dist:mac": "electron-builder --mac --universal --publish never"
  },
  "devDependencies": {
    "@capacitor/android": "^7.6.10",
    "@capacitor/cli": "^7.6.10",
    "@capacitor/core": "^7.6.10",
    "electron": "44.7.0",
    "electron-builder": "26.17.0"
  },
  "build": {
    "appId": "com.erwannl.idlerpg",
    "productName": "Ascendrya",
    "executableName": "Idle RPG",
    "copyright": "ErwannL",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "index.html",
      "src/**/*",
      "!src/core/cheat-codes.js",
      "assets/**/*",
      "desktop/**/*",
      "package.json"
    ],
    "electronLanguages": [
      "fr",
      "en-US"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Game",
      "icon": "build/icon.png",
      "artifactName": "IdleRPG-${version}.AppImage",
      "executableName": "ascendrya",
      "synopsis": "Ascendrya, un RPG incrémental"
    },
    "mac": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.games",
      "icon": "build/icon-mac.png",
      "artifactName": "IdleRPG-${version}-mac.zip",
      "identity": null
    },
    "nsis": {
      "artifactName": "IdleRPG-${version}-setup.exe",
      "oneClick": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Ascendrya",
      "deleteAppDataOnUninstall": false,
      "perMachine": false,
      "include": "build/installer.nsh",
      "runAfterFinish": true
    }
  },
  "dependencies": {
    "@capacitor/local-notifications": "^7.0.7"
  }
}
