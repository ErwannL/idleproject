{
  "name": "idle-rpg",
  "productName": "Idle RPG",
  "version": "9.0.8",
  "private": true,
  "description": "RPG idle 2D en pixel art pour PC (fenêtre compacte).",
  "author": "ErwannL",
  "type": "module",
  "main": "desktop/main.cjs",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node tools/serve.mjs",
    "build:web": "node tools/build-web.mjs",
    "server": "node server/index.mjs",
    "app": "node tools/launch.mjs",
    "desktop": "electron .",
    "test": "node --test",
    "smoke": "node tools/smoke.mjs",
    "art": "python3 tools/art/build.py",
    "export-assets": "node tools/export-assets.mjs",
    "dist:win": "electron-builder --win --publish never",
    "test:exe": "node tools/desktop-smoke.mjs",
    "test:upgrade": "node tools/upgrade-smoke.mjs"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.17.0"
  },
  "build": {
    "appId": "com.erwannl.idlerpg",
    "productName": "Idle RPG",
    "copyright": "ErwannL",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "index.html",
      "src/**/*",
      "assets/**/*",
      "desktop/**/*",
      "package.json"
    ],
    "electronLanguages": [
      "fr",
      "en-US"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "artifactName": "IdleRPG-${version}-setup.exe",
      "oneClick": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Idle RPG",
      "deleteAppDataOnUninstall": false,
      "perMachine": false,
      "include": "build/installer.nsh",
      "runAfterFinish": true
    }
  }
}
