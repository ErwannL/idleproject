# Serveur « games » (server/index.mjs). Copier en .env ou définir ces variables dans le service systemd.
# Aucun secret n'est requis pour le moment : pas de clé API, pas de mot de passe de base.
# Le domaine public se règle dans site/config.js (valeur placeholder : TON-DOMAINE.xyz).

# Port et adresse d'écoute. 127.0.0.1 : seul le tunnel/Funnel local peut atteindre le serveur.
PORT=8787
HOST=127.0.0.1

# Base SQLite (comptes, sauvegardes, préinscriptions). Créée au premier démarrage.
DB_FILE=/var/lib/idle-rpg/games.sqlite

# Dossiers servis : site d'accueil et version web du jeu (npm run build:web).
SITE_DIR=/srv/idle-rpg/site
WEB_DIR=/srv/idle-rpg/web

# 1 uniquement derrière un proxy de confiance (Cloudflare Tunnel) : utilise X-Forwarded-For pour la limitation.
TRUST_PROXY=0
