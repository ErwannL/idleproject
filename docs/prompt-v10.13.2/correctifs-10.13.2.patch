diff --git a/src/ui/mobile1014.css b/src/ui/mobile1014.css
new file mode 100644
index 00000000..63ce1a74
--- /dev/null
+++ b/src/ui/mobile1014.css
@@ -0,0 +1,64 @@
+/* v10.13.2 : contrôle téléphone de la 10.13.1 (captures 412 × 915 de chaque onglet). TÉLÉPHONE SEULEMENT : tout sous `#app.m-phone`.
+   1. Arène : la scène reste visible au-dessus du panneau, sans la pile du combat (zone, événements, carnet, chemin, console) posée dessus.
+   2. Sous-onglets du haut : tous visibles d'un coup (5 au plus), jamais un nom coupé au bord ; ui.js prend le nom court quand le long ne tient pas.
+   3. Rangées de modes qui défilent (Boutique, Collections) : fondu sur le bord tant qu'il reste des cases à voir.
+   4. Missions : les 5 modes tiennent sur une ligne.
+   5. Écran sans sous-onglets (Boutique, Invocation, Paramètres) : bandeau du haut réduit (plus de bande vide de 72 px). */
+
+/* 1. Arène (panneau sous la scène) : rien du combat par-dessus la scène. */
+#app.m-phone.panel-open:not(.page-ui) #hud106,
+#app#app.m-phone.panel-open:not(.page-ui) #stage-area #zone-card,
+#app.m-phone.panel-open:not(.page-ui) #goals-pill,
+#app.m-phone.panel-open:not(.page-ui) #combat-console,
+#app.m-phone.panel-open:not(.page-ui) #next-action,
+#app.m-phone.panel-open:not(.page-ui) #next-unlock,
+#app.m-phone.panel-open:not(.page-ui) #loot-bag,
+#app.m-phone.panel-open:not(.page-ui) #auto-toggle,
+#app.m-phone.panel-open:not(.page-ui) #quest-banner { display: none !important; }
+
+/* 2. Sous-onglets : partage égal de la largeur. */
+#app.m-phone #panel #panel-subtabs { gap: 4px; padding: 4px; }
+#app.m-phone #panel #panel-subtabs .subtab { flex: 1 1 0; min-width: 0; padding: 4px 2px 3px !important; }
+#app.m-phone #panel #panel-subtabs .subtab span { font-size: 11px; letter-spacing: -.3px; }
+#app.m-phone #panel #panel-subtabs .subtab.use-short .sub-long { display: none !important; }
+#app.m-phone #panel #panel-subtabs .subtab.use-short .sub-short { display: block !important; }
+#app.m-phone #panel #panel-subtabs.m-many .subtab { flex: 1 0 76px; min-width: 76px; } /* 6 et plus : la rangée défile (avec fondu, § 3) */
+
+/* 3. Fondu de bord sur les rangées qui défilent (animation liée au défilement : sans débordement, aucun fondu). */
+@property --m-fl { syntax: '<length>'; inherits: false; initial-value: 0px; }
+@property --m-fr { syntax: '<length>'; inherits: false; initial-value: 0px; }
+@keyframes m-edge-fade {
+  0% { --m-fl: 0px; --m-fr: 28px; }
+  8% { --m-fl: 28px; --m-fr: 28px; }
+  92% { --m-fl: 28px; --m-fr: 28px; }
+  100% { --m-fl: 28px; --m-fr: 0px; }
+}
+@supports (animation-timeline: scroll()) {
+  #app.m-phone .m-tabs, #app.m-phone .m-modes, #app.m-phone #panel #panel-subtabs.m-many {
+    animation: m-edge-fade linear both; animation-timeline: scroll(self x);
+    -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 var(--m-fl), #000 calc(100% - var(--m-fr)), transparent 100%);
+    mask-image: linear-gradient(90deg, transparent 0, #000 var(--m-fl), #000 calc(100% - var(--m-fr)), transparent 100%);
+  }
+}
+
+/* 4. Missions : 5 modes sur une ligne. */
+#app.m-phone .mp-frame .m-modes:has(> .m-mode:nth-child(5)):not(:has(> .m-mode:nth-child(6))) { gap: 4px; }
+#app.m-phone .mp-frame .m-modes:has(> .m-mode:nth-child(5)):not(:has(> .m-mode:nth-child(6))) .m-mode { flex: 1 1 0; min-width: 0; padding: 4px 2px 3px; }
+
+/* 5. Pas de sous-onglets : bandeau du haut à la taille du bouton ✕. */
+#app.m-phone #panel:has(> #panel-subtabs.hidden) > header { height: 48px !important; min-height: 48px !important; }
+
+/* 6. Arène : la barre d'action collée en bas du panneau a le vrai bouton doré du kit (au lieu d'un aplat terne). */
+#app.m-phone .phone-action { padding: 6px 8px 4px; }
+#app.m-phone .phone-action .btn-gold { min-height: 52px; border-radius: 14px; border: 2px solid #fff0b8; background: linear-gradient(180deg, #ffe08a, #f0b93f); color: #2a1a05; font-size: 16px; font-weight: 900; box-shadow: 0 3px 0 #8a5a12, 0 0 12px rgba(243, 210, 122, .35); }
+#app.m-phone .phone-action .btn-gold:disabled { filter: grayscale(.7) brightness(.7); }
+
+/* 7. Flèche dorée de conseil (après « Récupérer ») : vers le bas au-dessus du bouton du menu ; jamais par-dessus le menu latéral ou une fenêtre. */
+.gold-arrow.down { width: 24px; text-align: center; animation-name: gold-arrow-down; }
+@keyframes gold-arrow-down { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(6px); } }
+body:has(#modal:not(.hidden)) .gold-arrow { display: none; }
+
+/* 8. Menu ☰ : « Menu » en titre centré, ✕ à droite sur la même ligne (avant : ✕ seul au-dessus du titre). */
+#app.m-phone #modal .drawer > .drawer-close { position: absolute !important; top: 0; right: 0; left: auto; width: 44px; height: 44px; min-height: 44px; margin: 0; }
+#app.m-phone #modal .drawer > h2 { margin: 0 52px 10px; min-height: 44px; display: flex; align-items: center; justify-content: center; text-align: center; font-size: 20px; }
+#app.m-phone #panel #panel-subtabs.hidden { display: none !important; }
