@@ -0,0 +1,102 @@
+/* v10.12 : passe téléphone.
+   1. Prologue « film d'action » : bandes de cinéma, cartons de titre, éclairs d'impact, ralenti tant que le joueur
+      n'a pas touché, bouton d'action au pouce (au-dessus de la barre de gestes Android), réincarnation lisible. */
+.prologue2 { z-index: 9900; } /* au-dessus des éclats d'interface et du haut de l'écran (plus de gemme qui dépasse) */
+.prologue2 .pro-lb { position: absolute; left: 0; right: 0; height: 0; background: #000; z-index: 2; pointer-events: none; transition: height .9s cubic-bezier(.2,.8,.2,1); }
+.prologue2 .pro-lb.top { top: 0; } .prologue2 .pro-lb.bottom { bottom: 0; }
+@media (orientation: landscape) { .prologue2 .pro-lb { height: clamp(28px, 9vh, 90px); } .prologue2.in-rebirth .pro-lb { height: 0; } }
+/* Ralenti : l'image se fige presque, le cadre s'assombrit autour de l'action. */
+.prologue2 .pro-slow { position: absolute; inset: 0; z-index: 2; pointer-events: none; opacity: 0; transition: opacity .25s;
+  background: radial-gradient(ellipse at 50% 50%, transparent 35%, rgba(0,0,0,.75) 100%); }
+.prologue2.qte .pro-slow { opacity: 1; }
+.prologue2.qte .pro-canvas { filter: brightness(.9) saturate(.55) contrast(1.15); }
+.prologue2 .pro-flash { position: absolute; inset: 0; z-index: 5; pointer-events: none; opacity: 0; mix-blend-mode: screen; }
+.prologue2 .pro-flash.on { animation: pro-flash .32s ease-out; }
+@keyframes pro-flash { 0% { opacity: .85; } 100% { opacity: 0; } }
+/* Cartons de titre : arrivent en force, tiennent, s'effacent. */
+.prologue2 .pro-title { position: absolute; left: 0; right: 0; top: 13%; z-index: 4; display: flex; flex-direction: column; align-items: center; gap: 4px;
+  padding: 0 16px; text-align: center; pointer-events: none; opacity: 0; transition: opacity .5s; }
+.prologue2 .pro-title.show { opacity: 1; }
+.prologue2 .pro-title b { font: 900 clamp(30px, 9vw, 64px)/1 system-ui, sans-serif; letter-spacing: .04em; text-transform: uppercase; color: #fff3d0;
+  text-shadow: 0 0 18px rgba(255, 190, 80, .7), 0 3px 0 #000, 0 0 2px #000; }
+.prologue2 .pro-title small { font: 700 clamp(12px, 3.4vw, 16px)/1.2 system-ui, sans-serif; letter-spacing: .22em; text-transform: uppercase; color: #d8c8a0; text-shadow: 0 1px 2px #000; }
+.prologue2 .pro-title.slam b { animation: pro-slam .55s cubic-bezier(.2,1.6,.4,1); }
+.prologue2 .pro-title.slam small { animation: pro-fade .8s .2s both; }
+.prologue2 .pro-title.boss b { color: #ffd0c0; text-shadow: 0 0 22px rgba(255, 60, 40, .85), 0 3px 0 #000; font-size: clamp(26px, 7.6vw, 56px); }
+.prologue2 .pro-title.ally b { color: #d8ffe0; text-shadow: 0 0 20px rgba(120, 255, 160, .7), 0 3px 0 #000; }
+.prologue2 .pro-title.rage b { color: #ff5a3a; font-size: clamp(44px, 16vw, 110px); text-shadow: 0 0 30px #ff2a1a, 0 4px 0 #000; }
+@keyframes pro-slam { 0% { transform: scale(2.6); opacity: 0; filter: blur(6px); } 60% { opacity: 1; filter: none; } 100% { transform: scale(1); } }
+/* Chiffre d'impact au centre de la scène. */
+.prologue2 .pro-dmg { position: absolute; left: 0; right: 0; top: 46%; z-index: 4; text-align: center; pointer-events: none; opacity: 0;
+  font: 900 clamp(26px, 8vw, 54px)/1 system-ui, sans-serif; color: #ffe07a; text-shadow: 0 0 14px #ff9d2a, 0 3px 0 #000; }
+.prologue2 .pro-dmg.on { animation: pro-dmg 1.1s ease-out forwards; }
+.prologue2 .pro-dmg.weak { color: #d8dce8; font-size: clamp(18px, 5.4vw, 32px); text-shadow: 0 2px 0 #000; }
+.prologue2 .pro-dmg.heal { color: #9dffb4; text-shadow: 0 0 14px #2fa84f, 0 3px 0 #000; }
+.prologue2 .pro-dmg.fire { color: #ffb36a; text-shadow: 0 0 14px #ff5a1a, 0 3px 0 #000; }
+@keyframes pro-dmg { 0% { opacity: 0; transform: scale(2.2); } 15% { opacity: 1; transform: scale(1); } 75% { opacity: 1; } 100% { opacity: 0; transform: translateY(-40px); } }
+/* Sous-titres : plus de grand cadre vide, une ligne de film. */
+.prologue2 .pro-dialog { min-height: 0; border: 0; border-radius: 8px; background: rgba(0, 0, 0, .55); border-top: 0; padding: 8px 14px;
+  bottom: calc(max(120px, 15vh) + env(safe-area-inset-bottom)); font: 700 clamp(15px, 4.2vw, 19px)/1.35 system-ui, sans-serif; text-shadow: 0 1px 2px #000; }
+.prologue2.qte .pro-dialog { color: #ffe9a8; }
+/* Bouton d'action : gros, au pouce, bien au-dessus de la barre de gestes (le doigt n'est plus coupé). */
+.prologue2 .pro-actions { bottom: calc(max(34px, 5vh) + env(safe-area-inset-bottom)); gap: 14px; }
+.prologue2 .pro-act { display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-width: 150px; min-height: 64px; padding: 10px 20px; border-radius: 16px;
+  font: 900 19px system-ui, sans-serif; letter-spacing: .03em; text-transform: uppercase; border-width: 3px; touch-action: manipulation; -webkit-tap-highlight-color: transparent; }
+.prologue2 .pro-act .pro-ico { font-size: 22px; }
+.prologue2 .pro-act:active { transform: scale(.94); }
+.prologue2.qte .pro-act:not(.hidden):not(.used) { animation: pro-qte .55s ease-in-out infinite; box-shadow: 0 0 0 0 rgba(255, 210, 63, .7); }
+@keyframes pro-qte { 50% { transform: scale(1.1); box-shadow: 0 0 0 12px rgba(255, 210, 63, 0), 0 0 26px #ffd23f; } }
+.prologue2 .pro-finger { top: auto; bottom: -6px; left: auto; right: -14px; margin: 0; font-size: 30px; }
+.prologue2:not(.qte) .pro-finger { display: none; }
+@media (max-width: 560px) {
+  .prologue2 .pro-act { min-width: 132px; min-height: 64px; font-size: 17px; }
+  .prologue2 .pro-dialog { font-size: 15px; bottom: calc(max(116px, 14vh) + env(safe-area-inset-bottom)); }
+}
+/* Réincarnation : l'ange sans cadre gris, le choix lisible, puis un voile blanc (au lieu d'une page délavée). */
+.prologue2 .pro-entity { background-color: transparent; box-shadow: none; border-radius: 0; filter: drop-shadow(0 0 22px rgba(255, 236, 170, .75)); width: min(46vw, 180px); height: min(26vh, 220px); }
+.prologue2 .pro-voice { font-size: clamp(16px, 4.4vw, 20px); text-shadow: 0 1px 3px #000; padding: 0 16px; }
+.prologue2 .pro-b { background: linear-gradient(#2c2252, #1a1436); border: 2px solid #b9a2ff; color: #fff; text-align: center; }
+.prologue2 .pro-b b { font-size: 17px; color: #ffe9a8; }
+.prologue2 .pro-b small { color: #e4dcff; font-size: 13px; }
+.prologue2 .pro-b:active { transform: scale(.97); }
+.prologue2 .pro-name { align-items: center; width: min(320px, 100%); }
+.prologue2 .pro-name span { color: #cfc4ef; font-size: 13px; }
+.prologue2 .pro-name input { width: 100%; min-height: 44px; border: 2px solid #6a5f9a; background: #0f0c22; }
+.prologue2.light .pro-rebirth { animation: none; }
+.prologue2.light .pro-b:not(.picked), .prologue2.light .pro-name { opacity: 0; transition: opacity .3s; }
+.prologue2.light .pro-b.picked { box-shadow: 0 0 0 3px #ffe9a8, 0 0 36px #ffd23f; transform: scale(1.05); transition: transform .3s, box-shadow .3s; }
+.prologue2.light .pro-white { opacity: 1 !important; transition: opacity 1.1s .35s ease-in; z-index: 7; }
+@media (prefers-reduced-motion: reduce) { .prologue2 .pro-title.slam b, .prologue2 .pro-dmg.on, .prologue2 .pro-flash.on { animation-duration: 1ms !important; } }
+
+/* 2. Équipement sur téléphone : la feuille de l'objet a une vraie barre de tête (poignée + ✕ de 44 px), le cadenas,
+      « Changer » et « Retirer » passent sur une rangée de gros boutons sous le nom : plus rien ne se chevauche. */
+@media (max-width: 600px) {
+  #unit-host .unit-pop.eq-pop { overscroll-behavior: contain; }
+  .eq-pop .eq-sheet { position: relative; padding-top: 14px; }
+  .eq-pop .eq-sheet::before { content: ''; position: absolute; left: 50%; top: 6px; width: 40px; height: 4px; margin-left: -20px; border-radius: 2px; background: #3a4a70; }
+  .eq-pop .eq-close { position: absolute; top: 8px; right: 8px; width: 40px; height: 40px; min-height: 40px; padding: 0; display: inline-flex; align-items: center; justify-content: center; font-size: 18px; z-index: 4; }
+  .eq-pop .eq-tip { margin-right: 48px; }
+  .eq-pop .eq-sh-head { flex-wrap: wrap; padding-right: 48px; row-gap: 8px; }
+  .eq-pop .eq-tip + .eq-sh-head, .eq-pop .eq-tip ~ .eq-sh-head { padding-right: 0; }
+  .eq-pop .eq-sh-id { min-width: 0; flex: 1 1 0; }
+  .eq-pop .eq-head-acts { order: 3; flex: 1 0 100%; flex-direction: row; gap: 8px; margin-right: -48px; }
+  .eq-pop .eq-tip ~ .eq-sh-head .eq-head-acts { margin-right: 0; }
+  .eq-pop .eq-head-acts:empty { display: none; }
+  .eq-pop .eq-head-acts .btn.small { flex: 1 1 0; min-height: 44px; font-size: 15px; }
+  .eq-pop .eq-head-acts .eq-lock { order: 9; flex: none; width: 44px; height: 44px; align-self: auto; }
+  .eq-pop .eq-head-acts .eq-lock img { width: 20px; height: 20px; }
+  /* Les places de la fiche ne bougent pas d'une place à l'autre (même hauteur de tête). */
+  .eq-pop .eq-strip { min-height: 52px; }
+}
+
+/* 3. Écran de jeu sur téléphone. */
+@media (max-width: 600px) {
+  /* La consigne de quête en parchemin fait doublon avec le gros bouton doré du bas quand il est affiché : un seul
+     des deux, jamais l'un sur l'autre. */
+  #stage-area:has(#next-action:not(.hidden)) #next-unlock.parchment { display: none !important; }
+  /* Le bouton doré dit la consigne en entier (2 lignes), plus « Compétences (1/3) :… » coupé. */
+  #next-action #next-action-text { -webkit-line-clamp: 2; line-height: 1.15; }
+  /* Les onglets du téléphone : fond opaque, les textes du combat (« Attaque lourde ! ») ne transparaissent plus. */
+  #app#app.page-ui #panel#panel#panel { background: linear-gradient(180deg, #0b1226, #0a0f1f) !important; }
+}
+.prologue2 .pro-rebirth:has(.pro-choice:not(.hidden)) .pro-circle { display: none; } /* le halo passait sur « Ton nom » */
